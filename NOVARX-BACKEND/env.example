# .env.example
# Copy this file, rename it to .env, and fill in your actual values.
# NEVER commit .env to GitHub — add it to .gitignore

# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Local example (after installing PostgreSQL on your PC):
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/novarx_db"

# JWT secret — make this a long random string (at least 32 characters)
# Generate one at: https://generate-secret.vercel.app/32
JWT_SECRET="replace_this_with_a_long_random_secret_key_min_32_chars"

# Server port (optional — defaults to 3000)
PORT=3000
